{
  "name": "worktree-app-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "node scripts/capture.cjs",
    "render": "remotion render src/index.ts Demo out/demo.mp4 --crf=20",
    "gif": "ffmpeg -v error -y -i out/demo.mp4 -vf \"fps=10,scale=720:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=64:stats_mode=diff[p];[b][p]paletteuse=dither=none:diff_mode=rectangle\" ../docs/demo.gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3",
    "playwright-core": "1.63.0"
  }
}
