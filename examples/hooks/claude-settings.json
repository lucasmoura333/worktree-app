{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/wt-street-linux\" hook --agent claude || true", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/wt-street-linux\" hook --agent claude || true", "timeout": 5 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|idle_prompt",
        "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/wt-street-linux\" hook --agent claude || true", "timeout": 5 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/wt-street-linux\" hook --agent claude || true", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"$HOME/.local/bin/wt-street-linux\" hook --agent claude || true", "timeout": 5 }] }
    ]
  }
}
