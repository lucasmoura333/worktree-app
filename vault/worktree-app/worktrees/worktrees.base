# Generated by worktree-app/v1. Views may be customized; this file is created only once.
filters:
  and:
    - file.inFolder("worktree-app/worktrees")
    - 'type == "worktree"'
properties:
  slug:
    displayName: Worktree
  front:
    displayName: Frente
  last_savepoint:
    displayName: Último savepoint
  updated_at:
    displayName: Atualizado em
views:
  - type: cards
    name: Ativos
    filters: 'status == "ativo"'
    groupBy:
      property: note.front
      direction: ASC
    order:
      - note.slug
      - note.repo
      - note.branch
      - note.dirty
      - note.ahead
      - note.behind
      - note.port
      - note.last_savepoint
      - note.updated_at
  - type: table
    name: Tabela
    filters: 'status == "ativo"'
    groupBy:
      property: note.front
      direction: ASC
    order:
      - note.slug
      - note.repo
      - note.branch
      - note.front
      - note.dirty
      - note.ahead
      - note.behind
      - note.updated_at
  - type: table
    name: Removidos
    filters: 'status == "removido"'
    order:
      - note.slug
      - note.repo
      - note.branch
      - note.sha
      - note.last_savepoint
      - note.updated_at
